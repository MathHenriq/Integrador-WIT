# Projeto Supabase do Projeto Integrador (NÃO é o mesmo do WIT Dungeon).
# Settings > API no painel do Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional. Quando "true", a tela de confirmação chama a Edge Function
# enviar-confirmacao. Deixe "false" enquanto a Resend não estiver
# configurada — a reserva funciona igual, só não sai e-mail.
VITE_EMAIL_CONFIRMACAO=false
