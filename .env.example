# Projeto Supabase do Projeto Integrador (NÃO é o mesmo do WIT Dungeon).
# Settings > API no painel do Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional. Quando "true", a tela de confirmação chama a Edge Function
# enviar-confirmacao. Deixe "false" enquanto a Resend não estiver
# configurada — a reserva funciona igual, só não sai e-mail.
VITE_EMAIL_CONFIRMACAO=false

# O aviso de reserva nova para a equipe WIT NÃO passa por esta chave e
# não tem variável no site: ele é garantido pelo cron do banco sobre a
# fila `notificacoes`. O que ele precisa são secrets da Edge Function
# `notificar-equipe` (BREVO_API_KEY ou RESEND_API_KEY, EMAIL_REMETENTE,
# SITE_URL), não variáveis de build. Ver a seção 2.7 do HANDOFF.md.
